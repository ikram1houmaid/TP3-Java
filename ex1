import java.util.Scanner;

public class Test {
    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        System.out.print("Donner n : ");
        int n = sc.nextInt();

        double s = 0;

        for (int i = 1; i <= n; i++) {
            s = s + 1.0 / i;
        }

        System.out.println("La somme est : " + s);

        sc.close();
    }
}